/* carts/tidy/main.ajs — TIDY UP!(AC1 移植 · 模式1)
 * 地板屏/货架屏两张 BG 地图(X 切屏);机器人/物品/光标走 OAM。
 * 拿 5 件自动切货架、放错扣分、S/A/B/C 评级照搬 AC1。
 */
var D = JSON.parse(new TextDecoder().decode(cart.seg('data', 0).data));
var P = D.P, T = D.T, ROBOT = D.ROBOT, ITEM = D.ITEM, CURSOR = D.CURSOR;

var W = 240, H = 176;
var HUD_H = 16, TRAY_H = 16;
var FLOOR_TOP = 16, FLOOR_BOT = 160;
var MAX_HOLD = 5;
var CATS = [{ n: 'BOOK' }, { n: 'BOTTLE' }, { n: 'BOX' }];
var SLOTS = 6;

var scene, level, items, shelves, crates, hold, player, screenMode;
var timeF, score, mistakes, combo, transT, transTo, pops, parts, clearT, rank, blinkT, paused;
var t = 0, shakeT = 0;

function slotX(i) { return 18 + i * 36; }
function levelItemCount(lv) { return Math.min(18, 6 + (lv - 1) * 3); }
function buildLevel(lv) {
  var n = levelItemCount(lv);
  items = [];
  var counts = [0, 0, 0];
  for (var i = 0; i < n; i++) counts[i % 3]++;
  for (var c = 0; c < 3; c++) for (var j = 0; j < counts[c]; j++)
    items.push({ x: 0, y: 0, cat: c, taken: false, bob: rng() * 6.28 });
  crates = [];
  var nCr = Math.min(5, 1 + ((lv - 1) / 2 | 0));
  for (var k = 0; k < nCr; k++) {
    var ok = false, x = 0, y = 0;
    for (var tr = 0; tr < 40 && !ok; tr++) {
      x = 14 + rng() * 186 | 0; y = FLOOR_TOP + 8 + rng() * (FLOOR_BOT - FLOOR_TOP - 34) | 0;
      ok = crates.every(function (c2) { return Math.abs(c2.x - x) > 34 || Math.abs(c2.y - y) > 26; });
    }
    crates.push({ x: x, y: y, w: 22, h: 16 });
  }
  for (var it = 0; it < items.length; it++) {
    var it2 = items[it], ok2 = false;
    for (var tr2 = 0; tr2 < 80 && !ok2; tr2++) {
      it2.x = 12 + rng() * 216;
      it2.y = FLOOR_TOP + 8 + rng() * (FLOOR_BOT - FLOOR_TOP - 16);
      ok2 = crates.every(function (c3) { return it2.x < c3.x - 6 || it2.x > c3.x + c3.w + 6 || it2.y < c3.y - 6 || it2.y > c3.y + c3.h + 6; }) &&
            Math.hypot(it2.x - 120, it2.y - (FLOOR_TOP + FLOOR_BOT) / 2) > 24;
    }
  }
  var order = [0, 1, 2];
  for (var q = order.length - 1; q > 0; q--) { var r = (rng() * (q + 1)) | 0, tmp = order[q]; order[q] = order[r]; order[r] = tmp; }
  shelves = order.map(function (cat, r) { return { cat: cat, y: 30 + r * 40, slots: [null, null, null, null, null, null] }; });
  hold = [];
  screenMode = 'floor';
  timeF = 0; combo = 0;
  player = { x: 120, y: (FLOOR_TOP + FLOOR_BOT) / 2, face: 1, walk: 0 };
  pops = []; parts = [];
  scene = 'play'; transT = 0;
}
function startTransition(to) {
  if (scene !== 'play' || transT > 0) return;
  transTo = to; transT = 18;
  scene = 'transition';
  A.playSfx(0);
}
function pop(txt, x, y, ci) { pops.push({ t: txt, x: x, y: y, ci: ci, life: 40 }); }
function burst(x, y, n) {
  for (var i = 0; i < n; i++) {
    var a = rng() * 6.2832, sp = 0.4 + rng() * 1.4;
    parts.push({ x: x, y: y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 0.6, ci: P.WHITE, life: 14 + rng() * 14 | 0 });
  }
}
function pickup(it) {
  if (hold.length >= MAX_HOLD) return false;
  it.taken = true;
  hold.push(it.cat);
  burst(it.x, it.y, 6);
  A.playSfx(2);
  if (hold.length >= MAX_HOLD) startTransition('shelf');
  return true;
}
function placeAt(shelf, slotIdx) {
  var want = shelf.cat;
  var idx = hold.indexOf(want);
  if (idx < 0) return false;
  if (shelf.slots[slotIdx] != null) return false;
  hold.splice(idx, 1);
  shelf.slots[slotIdx] = want;
  combo++;
  var pts = 100 + (combo - 1) * 10;
  score += pts;
  burst(slotX(slotIdx) + 8, shelf.y + 8, 8);
  pop('+' + pts, slotX(slotIdx) + 8, shelf.y - 4, P.YELLOW);
  A.playSfx(2);
  if (hold.length === 0 && !levelDone()) startTransition('floor');
  return true;
}
function mistakeAt(x, y) {
  mistakes++; combo = 0; score = Math.max(0, score - 50);
  pop('WRONG!', x, y, P.RED);
  shakeT = 8;
  A.playSfx(3);
}
function levelDone() {
  return items.every(function (i) { return i.taken; }) && hold.length === 0 &&
         shelves.every(function (s) { return s.slots.filter(function (v) { return v != null; }).length === items.filter(function (i) { return i.cat === s.cat; }).length; });
}
function targetTime() { return 18 + items.length * 5; }
function calcRank() {
  var tt = timeF / 60, target = targetTime();
  if (mistakes === 0 && tt <= target) return 'S';
  if (tt <= target * 1.35 && mistakes <= 2) return 'A';
  if (tt <= target * 1.9) return 'B';
  return 'C';
}
function collideCrates(x, y) {
  for (var i = 0; i < crates.length; i++) {
    var c = crates[i];
    if (x > c.x - 7 && x < c.x + c.w + 7 && y > c.y - 7 && y < c.y + c.h + 7) return true;
  }
  return false;
}
function doUpdate() {
  t++;
  blinkT++;
  if (shakeT > 0) shakeT--;
  if (scene === 'title') {
    if (pad.start.pressed || pad.a.pressed) { level = 1; score = 0; mistakes = 0; buildLevel(level); }
    return;
  }
  if (paused) { if (pad.start.pressed) paused = false; return; }
  if (scene === 'clear') {
    if (pad.a.pressed || pad.start.pressed) { level++; mistakes = 0; buildLevel(level); }
    return;
  }
  if (scene === 'transition') {
    if (--transT <= 0) { screenMode = transTo; scene = 'play'; }
    return;
  }
  timeF++;
  if (pad.start.pressed) { paused = true; return; }
  if (pad.b.pressed) startTransition(screenMode === 'floor' ? 'shelf' : 'floor');
  var dx = 0, dy = 0;
  if (pad.left.down) dx -= 1;
  if (pad.right.down) dx += 1;
  if (pad.up.down) dy -= 1;
  if (pad.down.down) dy += 1;
  if (dx || dy) {
    var len = Math.hypot(dx, dy);
    var spd = 1.5;
    var solid = screenMode === 'floor' ? collideCrates : null;
    var nx = player.x + dx / len * spd, ny = player.y + dy / len * spd;
    if (solid && solid(nx, player.y)) nx = player.x;
    if (solid && solid(player.x, ny)) ny = player.y;
    player.x = Math.max(10, Math.min(W - 10, nx));
    player.y = Math.max(FLOOR_TOP + 8, Math.min(FLOOR_BOT - 6, ny));
    if (dx) player.face = dx > 0 ? 1 : -1;
    player.walk += 0.22;
  } else player.walk = 0;
  var click = pad.a.pressed;
  if (screenMode === 'floor') {
    if (click) {
      var near = items.filter(function (it) { return !it.taken && Math.hypot(it.x - player.x, it.y - player.y) < 22; });
      var bestI = null, bd = 1e9;
      for (var i = 0; i < near.length; i++) {
        var d = Math.hypot(near[i].x - player.x, near[i].y - player.y);
        if (d < bd) { bd = d; bestI = near[i]; }
      }
      if (bestI) pickup(bestI);
      else if (hold.length >= MAX_HOLD) pop('FULL!', player.x, player.y - 14, P.RED);
    }
  } else {
    if (click && hold.length > 0) {
      var bestS = null, bsd = 1e9;
      for (var s2 = 0; s2 < shelves.length; s2++) {
        var dd = Math.abs(shelves[s2].y + 6 - player.y);
        if (dd < bsd) { bsd = dd; bestS = shelves[s2]; }
      }
      var want = bestS.cat;
      if (hold.indexOf(want) >= 0) {
        var idx = bestS.slots.indexOf(null);
        if (idx >= 0) placeAt(bestS, idx);
      } else mistakeAt(player.x, player.y - 14);
    }
  }
  for (var pi = parts.length - 1; pi >= 0; pi--) {
    var p = parts[pi];
    p.x += p.vx; p.y += p.vy; p.vy += 0.06;
    if (--p.life <= 0) parts.splice(pi, 1);
  }
  for (var pj = pops.length - 1; pj >= 0; pj--) { pops[pj].y -= 0.4; if (--pops[pj].life <= 0) pops.splice(pj, 1); }
  if (levelDone() && transT <= 0) {
    rank = calcRank();
    writeSave();
    scene = 'clear';
    A.playSfx(5);
  }
}
/* —— BG 构建 —— */
function buildFloorMap() {
  S.mapSize(0, 30, 22);
  var e = new Uint16Array(30 * 22);
  for (var y = 2; y < 20; y++) for (var x = 0; x < 30; x++) {
    var ti = ((x + (y % 2) * 2) % 4 < 2) ? T.FLOOR_A : T.FLOOR_B;
    if (y === 2) ti = T.SKIRT;
    e[y * 30 + x] = S.entry(ti);
  }
  // 木箱
  for (var c = 0; c < crates.length; c++) {
    var cr = crates[c];
    var tx0 = Math.round(cr.x / 8), ty0 = Math.round(cr.y / 8);
    var tw = Math.max(2, Math.round(cr.w / 8)), th = Math.max(2, Math.round(cr.h / 8));
    for (var yy = 0; yy < th; yy++) for (var xx = 0; xx < tw; xx++)
      if (ty0 + yy < 20 && tx0 + xx < 30) e[(ty0 + yy) * 30 + tx0 + xx] = S.entry(T.CRATE);
  }
  S.setMap(0, 0, 0, 30, 22, e);
  S.scroll(0, 0, 0);
}
function buildShelfMap() {
  S.mapSize(0, 30, 22);
  var e = new Uint16Array(30 * 22);
  for (var y = 2; y < 20; y++) for (var x = 0; x < 30; x++)
    e[y * 30 + x] = S.entry((y % 2) ? T.WALL_A : T.WALL_B);
  for (var s = 0; s < shelves.length; s++) {
    var sh = shelves[s];
    var rowY = Math.round(sh.y / 8);
    for (var i = 0; i < SLOTS; i++) {
      var x0 = Math.round(slotX(i) / 8);
      for (var xx = 0; xx < 4; xx++)
        if (rowY >= 0 && rowY < 20) e[rowY * 30 + Math.min(29, x0 + xx)] = S.entry(T.SLOT);
    }
    // 层板
    var by = Math.round((sh.y + 16) / 8);
    for (var bx = 2; bx < 28; bx++) e[by * 30 + bx] = S.entry(T.SHELF);
  }
  S.setMap(0, 0, 0, 30, 22, e);
  S.scroll(0, 0, 0);
}
function draw() {
  if (scene === 'transition' && transT > 9) buildShelfMap();
  if (scene === 'transition' && transT <= 9) buildFloorMap();
  var i = 0;
  if (scene !== 'title') {
    // 地板屏:散落物品
    if (screenMode === 'floor') {
      for (var k = 0; k < items.length && i < 120; k++) {
        if (items[k].taken) continue;
        items[k].bob += 0.05;
        S.setSprite(i++, { x: (items[k].x - 4) | 0, y: (items[k].y + Math.sin(items[k].bob) * 1.2) | 0, tile: ITEM + items[k].cat, prio: 2 });
      }
    } else {
      // 货架屏:已放物品
      for (var s = 0; s < shelves.length; s++) {
        for (var sl = 0; sl < SLOTS && i < 120; sl++) {
          var cat = shelves[s].slots[sl];
          if (cat == null) continue;
          S.setSprite(i++, { x: slotX(sl) + 12, y: shelves[s].y - 1, tile: ITEM + cat, prio: 2 });
        }
      }
    }
    // 机器人(头顶货堆)
    S.setSprite(i++, { x: (player.x - 8) | 0, y: (player.y - 15 + Math.sin(player.walk) * 1.2) | 0, tile: ROBOT, prio: 3, fh: player.face < 0 ? 1 : 0 });
    var hh = 0;
    for (var h = hold.length - 1; h >= 0 && i < 127; h--)
      S.setSprite(i++, { x: (player.x - 4) | 0, y: (player.y - 24 - hh++ * 8) | 0, tile: ITEM + hold[h], prio: 3 });
    for (var pi = 0; pi < parts.length && i < 128; pi++)
      S.setSprite(i++, { x: parts[pi].x | 0, y: parts[pi].y | 0, tile: CURSOR, prio: 3 });
  }
  if (shakeT > 0) S.scroll(0, (t & 1) * 2 - 1, 0); else S.scroll(0, 0, 0);
  // 文本
  if (scene === 'title') {
    bios.text(78, 20, 'TIDY UP!', { color: P.YELLOW, scale: 2 });
    bios.text(24, 44, 'PICK 5 - SORT THEM - REPEAT', { color: P.LGRAY });
    var b = readSave();
    if (b.lv) bios.text(78, 58, 'BEST LV' + b.lv + ' ' + b.sc, { color: P.CYAN });
    if ((t % 60) < 38) bios.text(66, 84, 'PRESS START', { color: P.WHITE, scale: 2 });
    bios.text(24, 116, 'ARROWS MOVE - Z PICK', { color: P.SLATE });
    bios.text(48, 128, 'X SWITCH SCREEN', { color: P.SLATE });
  } else {
    var mm = (timeF / 3600) | 0, ss = ((timeF / 60) | 0) % 60;
    bios.text(4, 2, 'LV' + level, { color: P.WHITE });
    bios.text(40, 2, mm + ':' + ('0' + ss).slice(-2), { color: P.YELLOW });
    bios.text(84, 2, '' + score, { color: P.CYAN });
    bios.text(126, 2, 'MISS ' + mistakes, { color: mistakes ? P.RED : P.SLATE });
    bios.text(192, 2, screenMode === 'floor' ? 'FLOOR' : 'SHELF', { color: P.VIOLET });
    var holdTxt = '';
    for (var hi = 0; hi < MAX_HOLD; hi++) holdTxt += hi < hold.length ? ['B', 'L', 'X'][hold[hi]] : '-';
    bios.text(102, 164, holdTxt, { color: P.LGRAY });
    bios.text(4, 164, 'LEFT ' + items.filter(function (q) { return !q.taken; }).length, { color: P.LGRAY });
    for (var pj = 0; pj < pops.length; pj++)
      bios.text(pops[pj].x | 0, pops[pj].y | 0, pops[pj].t, { color: pops[pj].ci });
    if (scene === 'clear') {
      bios.text(60, 44, 'LEVEL ' + level + ' CLEAR', { color: P.WHITE, scale: 2 });
      bios.text(90, 70, 'TIME ' + ((timeF / 60) | 0) + 'S', { color: P.LGRAY });
      bios.text(84, 82, 'SCORE ' + score, { color: P.CYAN });
      bios.text(90, 94, 'MISS ' + mistakes, { color: mistakes ? P.RED : P.GREEN });
      bios.text(90, 106, 'RANK ' + rank, { color: rank === 'S' ? P.YELLOW : P.CYAN, scale: 2 });
      if ((t % 50) < 34) bios.text(84, 132, 'Z: NEXT LEVEL', { color: P.WHITE });
    }
    if (paused) {
      bios.text(90, 84, 'PAUSED', { color: P.WHITE, scale: 2 });
      bios.text(78, 100, 'ENTER:RESUME', { color: P.SLATE });
    }
    if (scene === 'transition' && transT > 0)
      bios.text(102, 84, transTo === 'shelf' ? 'SHELF' : 'FLOOR', { color: P.YELLOW, scale: 2 });
  }
}
function writeSave() {
  try {
    var b = readSave();
    if (level > b.lv || (level === b.lv && score > b.sc))
      save(new Uint8Array([level, 0, score & 255, score >> 8]));
  } catch (e) { }
}
function readSave() {
  var d = load();
  if (d && d.length >= 4) return { lv: d[0], sc: d[2] | (d[3] << 8) };
  return { lv: 0, sc: 0 };
}
function init() {
  S.loadTiles('bg', cart.seg('tilesbg', 0).data, 0);
  S.loadTiles('obj', cart.seg('tilesobj', 0).data, 0);
  S.backdrop(P.BG);
  scene = 'title';
  level = 1; score = 0; mistakes = 0;
  items = []; shelves = []; crates = []; hold = [];
  player = { x: 120, y: 90, face: 1, walk: 0 };
  timeF = 0; combo = 0; transT = 0; blinkT = 0;
  pops = []; parts = []; paused = false;
  buildFloorMap();
}
var _stepRef = doUpdate;
update = function () { _stepRef(); draw(); };
