/* carts/starfall/main.ajs — STARFALL(AC1 移植 · 模式1)
 * 星野走 BG(双速卷动两层);自机/敌/Boss/弹幕/掉落走 OAM(弹幕上限 100,擦弹判定不变)。
 * 波次脚本/Boss 三阶段/连击倍率照搬 AC1。240×176。
 */
var D = JSON.parse(new TextDecoder().decode(cart.seg('data', 0).data));
var P = D.P, T = D.T, SHIP = D.SHIP, FAIRY = D.FAIRY, ORB = D.ORB, DART = D.DART, TANK = D.TANK;
var BOSS = D.BOSS, PB_CYAN = D.PB_CYAN, PB_ICE = D.PB_ICE, EB = D.EB, PICK_P = D.PICK_P, PICK_G = D.PICK_G, DOT = D.DOT;

var W = 240, H = 176, TAU = 6.2832;
var EB_MAX = 100;

var scene, paused, freeze, flashT;
var px, py, inv, dead, respawnT, fireCd, bombT, bombs, lives, power, score, graze;
var chain, chainT, enemies, ebul, pbul, parts, pops, drops;
var stars, wave, waveT, script, groupIdx, bossWait, boss, bossSeq, bossExpT;
var bannerT, bannerA, bannerB, overT, best, t = 0, shakeT = 0;

function aimAt(x, y, spd) {
  var a = Math.atan2(py - y, px - x);
  return [Math.cos(a) * spd, Math.sin(a) * spd];
}
function d2(ax, ay, bx, by) { var dx = ax - bx, dy = ay - by; return dx * dx + dy * dy; }
function burst(x, y, n, ci, sp) {
  for (var i = 0; i < n; i++) {
    var a = rng() * TAU, v = sp * (0.25 + rng() * 0.75);
    parts.push({ x: x, y: y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, ci: ci, life: 14 + rng() * 16 | 0 });
  }
}
function pop(txt, x, y, ci) { pops.push({ t: txt, x: x, y: y, ci: ci, life: 40 }); }
function killFx(x, y, big) {
  burst(x, y, big ? 30 : 12, P.WHITE, big ? 3.4 : 2.2);
  burst(x, y, big ? 16 : 8, big ? P.ORANGE : P.YELLOW, big ? 2.6 : 1.7);
  shakeT = big ? 12 : 5;
  freeze = Math.max(freeze, big ? 6 : 2);
}
function buildWave(n) {
  var ev = [];
  var tt = 46;
  var groups = 4 + Math.min(4, n);
  for (var g = 0; g < groups; g++) {
    ev.push({ t: tt, kind: (rng() * (n >= 2 ? 5 : 3)) | 0 });
    tt += 78 + (rng() * 50 | 0) - Math.min(28, n * 3);
  }
  ev.total = tt + 150;
  return ev;
}
function spawnGroup(kind) {
  var hpUp = 1 + wave * 0.12;
  if (kind === 0 || kind === 1) {
    var side = kind === 0 ? -1 : 1;
    for (var i = 0; i < 5; i++)
      enemies.push({ type: 'fairy', bx: side < 0 ? 34 : W - 34, x: side < 0 ? 26 : W + 26, y: 20 + i * 9, hp: Math.ceil(2 * hpUp), r: 6, tt: -i * 9, fcd: 50 + (rng() * 100 | 0), score: 60, side: side });
  } else if (kind === 2) {
    var n = wave > 3 ? 2 : 1;
    for (var j = 0; j < n; j++)
      enemies.push({ type: 'orb', x: 50 + j * (W - 100), y: -14 - j * 26, ty: 34 + (rng() * 28 | 0), hp: Math.ceil(9 * hpUp), r: 6, tt: 0, fcd: 70, rings: 0, score: 220 });
  } else if (kind === 3) {
    var n2 = 3 + (rng() * 3 | 0);
    for (var k = 0; k < n2; k++)
      enemies.push({ type: 'dart', x: 20 + rng() * (W - 40), y: -12 - k * 16, hp: Math.ceil(2 * hpUp), r: 4, tt: 0, vx: 0, vy: 0, aimed: false, score: 90 });
  } else if (kind === 4) {
    var n3 = wave > 4 ? 2 : 1;
    for (var m = 0; m < n3; m++)
      enemies.push({ type: 'tank', x: 60 + m * (W - 120) + (rng() * 28 - 14), y: -16, hp: Math.ceil(14 * hpUp), r: 8, tt: 0, fcd: 64, score: 300 });
  } else {
    for (var a = 0; a < 3; a++)
      enemies.push({ type: 'fairy', bx: 40 + rng() * (W - 80), x: rng() * W, y: -10 - a * 14, hp: Math.ceil(2 * hpUp), r: 6, tt: 0, fcd: 60 + (rng() * 100 | 0), score: 60, side: 0 });
    for (var b = 0; b < 3; b++)
      enemies.push({ type: 'dart', x: 20 + rng() * (W - 40), y: -70 - b * 16, hp: Math.ceil(2 * hpUp), r: 4, tt: 0, vx: 0, vy: 0, aimed: false, score: 90 });
  }
}
function spawnBoss() {
  boss = { type: 'boss', x: W / 2, y: -34, hp: 320 + wave * 95, maxHp: 320 + wave * 95, r: 13, tt: 0, fcd: 14, fcd2: 60, phase: 0, score: 4000 + wave * 300 };
  enemies.push(boss);
}
function eShot(x, y, vx, vy, ci, big) {
  if (ebul.length >= EB_MAX) return;
  ebul.push({ x: x, y: y, vx: vx, vy: vy, ci: ci, big: !!big, age: 0, gz: false });
}
function ringShot(x, y, n, spd, off, ci) {
  for (var i = 0; i < n; i++) {
    var a = off + i * TAU / n;
    eShot(x, y, Math.cos(a) * spd, Math.sin(a) * spd, ci, spd > 1.15);
  }
}
function firePlayer() {
  var cd = power >= 4 ? 5 : 7;
  if (fireCd > 0) return;
  fireCd = cd;
  var y = py - 8;
  pbul.push({ x: px, y: y, vx: 0, vy: -7.2, ci: P.CYAN });
  if (power >= 2) { pbul.push({ x: px - 4, y: y, vx: 0, vy: -7.2, ci: P.CYAN }); pbul.push({ x: px + 4, y: y, vx: 0, vy: -7.2, ci: P.CYAN }); }
  if (power >= 3) { pbul.push({ x: px - 7, y: y + 3, vx: -1.15, vy: -6.4, ci: P.ICE }); pbul.push({ x: px + 7, y: y + 3, vx: 1.15, vy: -6.4, ci: P.ICE }); }
  if (power >= 4) { pbul.push({ x: px - 2, y: y, vx: 0, vy: -7.6, ci: P.WHITE }); pbul.push({ x: px + 2, y: y, vx: 0, vy: -7.6, ci: P.WHITE }); }
}
function playerDie() {
  dead = true;
  freeze = 10; flashT = 8; shakeT = 14;
  killFx(px, py, true);
  for (var i = 0; i < ebul.length; i++) {
    parts.push({ x: ebul[i].x, y: ebul[i].y, vx: rng() * 1.6 - 0.8, vy: rng() * 1.6 - 0.8, ci: P.PINK, life: 16 });
    score += 5;
  }
  ebul.length = 0;
  power = Math.max(0, power - 1);
  lives--;
  A.playSfx(3);
  if (lives < 0) { writeSave(); scene = 'over'; overT = 0; }
  else { inv = 0; respawnT = 66; }
}
function hurtEnemy(e, dmg) {
  e.hp -= dmg;
  e.flash = 3;
  if (e.hp <= 0) {
    e.deadF = true;
    chain++; chainT = 90;
    var mult = 1 + Math.min(2, (chain - 1) * 0.08);
    score += Math.round(e.score * mult);
    var big = e.type === 'tank' || e.type === 'boss';
    killFx(e.x, e.y, big);
    A.playSfx(big ? 4 : 1);
    if (e.type === 'boss') return;
    if (rng() < (big ? 0.5 : 0.14))
      drops.push({ x: e.x, y: e.y, kind: rng() < 0.6 ? 'P' : 'G', tt: 0 });
  }
}
function updateBossSeq() {
  bossExpT++;
  if (bossExpT % 6 === 0 && boss) {
    burst(boss.x + rng() * 44 - 22, boss.y + rng() * 32 - 16, 10, [P.WHITE, P.ORANGE, P.YELLOW][(rng() * 3) | 0], 2.8);
    shakeT = 8;
  }
  if (bossExpT === 70) {
    flashT = 10;
    burst(boss.x, boss.y, 40, P.WHITE, 4.2);
    score += boss.score;
    pop('+' + boss.score, W / 2 - 24, boss.y, P.GOLD);
    for (var i = 0; i < 3; i++) drops.push({ x: boss.x - 20 + i * 20, y: boss.y, kind: i === 0 ? 'P' : 'G', tt: 0 });
    enemies.length = 0;
    boss = null;
    A.playSfx(5);
  }
  if (bossExpT > 110) {
    bossSeq = false;
    wave++;
    script = buildWave(wave);
    waveT = 0; groupIdx = 0; bossWait = 0;
    bannerT = 90; bannerA = 'WAVE ' + wave; bannerB = wave % 4 === 0 ? 'BOSS NEAR' : '';
  }
}
function resetRun() {
  scene = 'play'; paused = false;
  px = W / 2; py = H - 26; inv = 60; dead = false;
  fireCd = 0; bombT = 0; bombs = 2; lives = 3; power = 1;
  score = 0; graze = 0; chain = 0; chainT = 0;
  enemies = []; ebul = []; pbul = []; parts = []; pops = []; drops = [];
  boss = null; bossSeq = false; bossWait = 0;
  wave = 1; script = buildWave(1); waveT = 0; groupIdx = 0;
  bannerT = 100; bannerA = 'WAVE 1'; bannerB = '';
  freeze = 0; flashT = 0; overT = 0;
}
function updateBoss(e) {
  e.phase = e.hp > e.maxHp * 0.66 ? 0 : e.hp > e.maxHp * 0.33 ? 1 : 2;
  var amp = [26, 36, 46][e.phase];
  if (e.tt < 80) { e.y += (44 - e.y) * 0.06; return; }
  e.x = W / 2 + Math.sin(e.tt * 0.017) * amp;
  e.y = 44 + Math.sin(e.tt * 0.011) * 7;
  if (--e.fcd <= 0) {
    if (e.phase === 0) { e.fcd = 46; ringShot(e.x, e.y, 22, 0.62, e.tt * 0.29, 0); }
    else if (e.phase === 1) {
      e.fcd = 7;
      var a = e.tt * 0.13;
      eShot(e.x, e.y, Math.cos(a) * 0.9, Math.sin(a) * 0.9, 2);
      eShot(e.x, e.y, Math.cos(a + Math.PI) * 0.9, Math.sin(a + Math.PI) * 0.9, 2);
    } else { e.fcd = 36; ringShot(e.x, e.y, 26, 0.78, e.tt * 0.41, 4); }
  }
  if (--e.fcd2 <= 0) {
    e.fcd2 = e.phase === 2 ? 44 : 120;
    var n = e.phase === 2 ? 3 : 5;
    var base = Math.atan2(py - e.y, px - e.x);
    var spread = e.phase === 2 ? 0.16 : 0.42;
    for (var k = 0; k < n; k++) {
      var a2 = base + (k - (n - 1) / 2) * spread;
      var spd = e.phase === 2 ? 2.0 : 1.4;
      eShot(e.x, e.y, Math.cos(a2) * spd, Math.sin(a2) * spd, 7, true);
    }
  }
}
function updatePlay() {
  if (bannerT > 0) bannerT--;
  if (chainT > 0) { if (--chainT <= 0) chain = 0; }
  if (flashT > 0) flashT--;
  if (freeze > 0) { freeze--; updateParts(); return; }
  if (!dead) {
    var sp = 1.9, mx = 0, my = 0;
    if (pad.left.down) mx -= 1;
    if (pad.right.down) mx += 1;
    if (pad.up.down) my -= 1;
    if (pad.down.down) my += 1;
    if (mx && my) { mx *= 0.707; my *= 0.707; }
    px = Math.max(6, Math.min(W - 6, px + mx * sp));
    py = Math.max(10, Math.min(H - 8, py + my * sp));
    if (inv > 0) inv--;
    if (pad.a.down) { firePlayer(); }
    if (fireCd > 0) fireCd--;
    if (pad.b.pressed && bombs > 0 && bombT <= 0) {
      bombs--; bombT = 46; inv = Math.max(inv, 80);
      freeze = 3; flashT = 3; shakeT = 10;
      score += 30;
      A.playSfx(4);
    }
    if (t % 3 === 0) parts.push({ x: px + rng() * 2 - 1, y: py + 7, vx: 0, vy: 1.6, ci: (t % 6) ? P.ORANGE : P.YELLOW, life: 5 });
  } else if (--respawnT <= 0) {
    dead = false; px = W / 2; py = H - 26; inv = 150; bombT = 0;
  }
  if (bombT > 0) {
    bombT--;
    var r = (46 - bombT) * 5.6;
    for (var i = ebul.length - 1; i >= 0; i--) {
      if (d2(ebul[i].x, ebul[i].y, px, py) < r * r) {
        burst(ebul[i].x, ebul[i].y, 2, P.PINK, 1.2);
        score += 10;
        ebul.splice(i, 1);
      }
    }
    for (var e0 = 0; e0 < enemies.length; e0++) {
      var en = enemies[e0];
      if (!en.deadF && d2(en.x, en.y, px, py) < r * r) hurtEnemy(en, en.type === 'boss' ? 1.6 : 3);
    }
    enemies = enemies.filter(function (q) { return !q.deadF; });
  }
  waveT++;
  if (!boss && !bossSeq) {
    while (groupIdx < script.length && script[groupIdx].t <= waveT) {
      spawnGroup(script[groupIdx].kind);
      groupIdx++;
    }
    if (groupIdx >= script.length && waveT > script.total) {
      for (var e1 = 0; e1 < enemies.length; e1++) { burst(enemies[e1].x, enemies[e1].y, 6, P.WHITE, 1.8); score += 20; }
      enemies.length = 0;
      if (wave % 4 === 0) {
        if (bossWait < 60) {
          bossWait++;
          if (bossWait === 1) { shakeT = 8; bannerT = 90; bannerA = 'WARNING'; bannerB = 'LARGE ENEMY'; }
        } else { spawnBoss(); waveT = 0; }
      } else {
        wave++;
        script = buildWave(wave);
        waveT = 0; groupIdx = 0;
        bannerT = 80; bannerA = 'WAVE ' + wave; bannerB = '';
      }
    }
  }
  if (bossSeq) updateBossSeq();
  for (var pb = pbul.length - 1; pb >= 0; pb--) {
    var b = pbul[pb];
    b.x += b.vx; b.y += b.vy;
    if (b.y < -6 || b.x < -6 || b.x > W + 6) { pbul.splice(pb, 1); continue; }
    var hit = false;
    for (var e2 = 0; e2 < enemies.length; e2++) {
      var en2 = enemies[e2];
      if (en2.deadF || en2.y < -20) continue;
      var rr = en2.r + 2;
      if (d2(b.x, b.y, en2.x, en2.y) < rr * rr) { hurtEnemy(en2, 1); hit = true; break; }
    }
    if (hit) pbul.splice(pb, 1);
  }
  enemies = enemies.filter(function (q) { return !q.deadF; });
  for (var e3 = 0; e3 < enemies.length; e3++) {
    var e = enemies[e3];
    e.tt++;
    if (e.flash > 0) e.flash--;
    if (e.type === 'fairy') {
      e.y += 0.55;
      if (e.side) {
        var tx = e.bx - e.side * 10;
        e.x += (tx - e.x) * 0.04 + Math.sin(e.tt * 0.06 + e.bx) * 0.55;
      }
      if (e.y > 24 && e.y < 110 && --e.fcd <= 0) {
        e.fcd = 110 + (rng() * 80 | 0);
        var v = aimAt(e.x, e.y, 1.25);
        eShot(e.x, e.y + 4, v[0], v[1], 0);
      }
    } else if (e.type === 'orb') {
      if (e.y < e.ty) e.y += 0.7;
      e.x += Math.sin(e.tt * 0.02 + e.ty) * 0.3;
      if (e.y >= e.ty - 2 && --e.fcd <= 0) {
        e.fcd = 86;
        e.rings++;
        ringShot(e.x, e.y, 12 + (e.rings % 3 === 0 ? 4 : 0), 0.58, e.rings * 0.24, e.rings % 2 ? 2 : 0);
        if (e.rings % 3 === 0) { var v2 = aimAt(e.x, e.y, 1.5); eShot(e.x, e.y, v2[0], v2[1], 7, true); }
      }
    } else if (e.type === 'dart') {
      if (!e.aimed && e.y > 8) {
        e.aimed = true;
        var v3 = aimAt(e.x, e.y, 2.7);
        e.vx = v3[0]; e.vy = v3[1];
        burst(e.x, e.y, 3, P.ICE, 0.8);
      }
      e.x += e.vx; e.y += e.aimed ? e.vy : 1.1;
    } else if (e.type === 'tank') {
      e.y += 0.28;
      if (e.y > 20 && --e.fcd <= 0) {
        e.fcd = 104;
        var base = Math.atan2(py - e.y, px - e.x);
        for (var k2 = -1; k2 <= 1; k2++)
          eShot(e.x, e.y + 5, Math.cos(base + k2 * 0.3) * 1.5, Math.sin(base + k2 * 0.3) * 1.5, 1, true);
      }
    } else if (e.type === 'boss') updateBoss(e);
  }
  for (var e4 = enemies.length - 1; e4 >= 0; e4--) {
    var en3 = enemies[e4];
    if (en3.type !== 'boss' && (en3.y > H + 20 || en3.x < -30 || en3.x > W + 30)) enemies.splice(e4, 1);
  }
  for (var eb = ebul.length - 1; eb >= 0; eb--) {
    var bb = ebul[eb];
    bb.x += bb.vx; bb.y += bb.vy;
    bb.age++;
    if (bb.x < -8 || bb.x > W + 8 || bb.y < -10 || bb.y > H + 10) { ebul.splice(eb, 1); continue; }
    if (dead) continue;
    var dd = d2(bb.x, bb.y, px, py);
    var hitR = bb.big ? 3.4 : 2.6;
    if (dd < hitR * hitR) {
      if (inv <= 0) { ebul.splice(eb, 1); playerDie(); break; }
    } else if (!bb.gz && dd < 121 && inv <= 0) {
      bb.gz = true; graze++; score += 2;
      parts.push({ x: bb.x, y: bb.y, vx: rng() * 2 - 1, vy: rng() * 2 - 1, ci: P.ICE, life: 5 });
    }
  }
  for (var dr = drops.length - 1; dr >= 0; dr--) {
    var dp = drops[dr];
    dp.tt++;
    dp.y += 0.7;
    if (d2(dp.x, dp.y, px, py) < 26 * 26) { dp.x += (px - dp.x) * 0.12; dp.y += (py - dp.y) * 0.12; }
    if (d2(dp.x, dp.y, px, py) < 30 && !dead) {
      if (dp.kind === 'P') {
        if (power < 4) { power++; pop('POWER UP!', dp.x - 24, dp.y - 6, P.CYAN); }
        else { score += 500; pop('+500', dp.x - 12, dp.y - 6, P.GOLD); }
        flashT = 1;
      } else { score += 500; pop('+500', dp.x - 12, dp.y - 6, P.GOLD); }
      burst(dp.x, dp.y, 8, P.GOLD, 1.6);
      A.playSfx(2);
      drops.splice(dr, 1);
    } else if (dp.y > H + 10) drops.splice(dr, 1);
  }
  if (!dead && inv <= 0) {
    for (var e5 = 0; e5 < enemies.length; e5++) {
      var en4 = enemies[e5];
      if (en4.deadF || en4.y < -10) continue;
      var rr2 = en4.r + 2.5;
      if (d2(en4.x, en4.y, px, py) < rr2 * rr2) { playerDie(); break; }
    }
  }
  updateParts();
}
function updateParts() {
  for (var i = parts.length - 1; i >= 0; i--) {
    var p = parts[i];
    p.x += p.vx; p.y += p.vy;
    p.vx *= 0.93; p.vy *= 0.93;
    if (--p.life <= 0) parts.splice(i, 1);
  }
  if (parts.length > 36) parts.splice(0, parts.length - 36);
  for (var j = pops.length - 1; j >= 0; j--) { pops[j].y -= 0.45; if (--pops[j].life <= 0) pops.splice(j, 1); }
}
function doUpdate() {
  t++;
  if (scene === 'title') { if (pad.start.pressed || pad.a.pressed) resetRun(); return; }
  if (scene === 'over') {
    overT++;
    updateParts();
    if (overT > 40 && (pad.start.pressed || pad.a.pressed)) scene = 'title';
    return;
  }
  if (pad.start.pressed) paused = !paused;
  if (paused) return;
  updatePlay();
}
/* —— 绘制 —— */
function draw() {
  // 星野滚动(BG0 快层)
  var scr = (t * 1.2) % 176;
  S.scroll(0, 0, scr);
  if (shakeT > 0) { S.scroll(0, (t & 1) * 2 - 1, scr + ((t & 1) * 2 - 1)); shakeT--; }
  var i = 0;
  // 掉落物
  for (var dr = 0; dr < drops.length && i < 122; dr++)
    S.setSprite(i++, { x: (drops[dr].x - 4) | 0, y: drops[dr].y | 0, tile: drops[dr].kind === 'P' ? PICK_P : PICK_G, prio: 2 });
  // 自机弹
  for (var pb = 0; pb < pbul.length && i < 122; pb++)
    S.setSprite(i++, { x: pbul[pb].x | 0, y: pbul[pb].y | 0, tile: pbul[pb].ci === P.ICE ? PB_ICE : PB_CYAN, prio: 3 });
  // 敌人
  for (var e = 0; e < enemies.length && i < 118; e++) {
    var en = enemies[e];
    var ti = FAIRY + ((t >> 2) & 1) * 4;
    if (en.type === 'fairy') ti = FAIRY + ((t >> 2) & 1) * 4;
    else if (en.type === 'orb') ti = ORB;
    else if (en.type === 'dart') ti = DART;
    else if (en.type === 'tank') ti = TANK;
    else ti = -1;
    if (en.type === 'boss') {
      for (var q = 0; q < 6 && i < 128; q++)
        S.setSprite(i++, { x: (en.x - 24 + (q % 3) * 16) | 0, y: (en.y - 16 + ((q / 3) | 0) * 16) | 0, tile: BOSS + q, prio: 2 });
    } else {
      S.setSprite(i++, { x: (en.x - 8) | 0, y: (en.y - 8) | 0, tile: ti, prio: 2 });
    }
  }
  // 自机
  if (!dead && (inv <= 0 || (t % 6) >= 3) && i < 126)
    S.setSprite(i++, { x: (px - 8) | 0, y: (py - 8) | 0, tile: SHIP, prio: 3 });
  // 敌弹(最上层)
  for (var eb = 0; eb < ebul.length && i < 128; eb++) {
    var bb = ebul[eb];
    S.setSprite(i++, { x: (bb.x - 4) | 0, y: (bb.y - 4) | 0, tile: EB + bb.ci * 2 + (bb.big ? 1 : 0), prio: 3 });
  }
  // 粒子(有富余再画)
  for (var pi = 0; pi < parts.length && i < 128; pi += 2)
    S.setSprite(i++, { x: parts[pi].x | 0, y: parts[pi].y | 0, tile: DOT, prio: 1 });
  // 文本
  if (scene === 'title') {
    bios.text(60, 16, 'STARFALL', { color: P.GOLD, scale: 2 });
    bios.text(66, 40, 'DANMAKU SHOOTER', { color: P.CYAN });
    if (best > 0) bios.text(90, 54, 'BEST ' + best, { color: P.YELLOW });
    if ((t % 60) < 38) bios.text(66, 100, 'PRESS START', { color: P.WHITE });
    bios.text(48, 122, 'ARROWS - MOVE  Z - FIRE', { color: P.LGRAY });
    bios.text(54, 134, 'X - SPELL CARD', { color: P.LGRAY });
    bios.text(42, 148, 'SKIM BULLETS FOR GRAZE', { color: P.SLATE });
  } else {
    bios.text(4, 2, '' + score, { color: P.GOLD });
    bios.text(4, 16, 'HI ' + Math.max(best, score), { color: P.SLATE });
    bios.text(204, 2, 'W' + wave, { color: boss ? P.RED : P.LGRAY });
    var lv = '';
    for (var li = 0; li < Math.max(0, lives); li++) lv += 'A ';
    bios.text(4, 30, lv, { color: P.CYAN });
    var bm = '';
    for (var bi2 = 0; bi2 < bombs; bi2++) bm += '* ';
    bios.text(4, 44, bm, { color: P.ICE });
    bios.text(190, 164, 'GZ ' + graze, { color: P.ICE });
    if (chain >= 3) bios.text(190, 16, 'X' + chain, { color: chainT > 20 ? P.YELLOW : P.SLATE });
    if (boss && !bossSeq) {
      bios.text(9, 58, '                            ', { color: P.INK });
      var bar = '';
      var n2 = Math.round(24 * Math.max(0, boss.hp) / boss.maxHp);
      for (var bl = 0; bl < 24; bl++) bar += bl < n2 ? '=' : '-';
      bios.text(12, 58, bar, { color: boss.phase === 2 ? P.RED : P.VIOLET });
    }
    for (var pj = 0; pj < pops.length; pj++)
      bios.text(pops[pj].x | 0, pops[pj].y | 0, pops[pj].t, { color: pops[pj].ci });
    if (bannerT > 0 && (bannerT > 16 || (t & 3) < 2)) {
      var warn = bannerA === 'WARNING';
      bios.text((W - bannerA.length * 24) / 2 | 0, 64, bannerA, { color: warn ? P.RED : P.WHITE, scale: 2 });
      if (bannerB) bios.text((W - bannerB.length * 12) / 2 | 0, 84, bannerB, { color: warn ? P.YELLOW : P.GOLD });
    }
    if (bombT > 0) bios.text(66, 58, 'SPELL CARD', { color: P.WHITE });
    if (scene === 'over') {
      bios.text(60, 50, 'GAME OVER', { color: P.RED, scale: 2 });
      bios.text(72, 78, 'SCORE ' + score, { color: P.WHITE });
      bios.text(66, 92, 'WAVE ' + wave + ' GZ ' + graze, { color: P.LGRAY });
      bios.text(78, 106, 'BEST ' + best, { color: P.YELLOW });
      if (overT > 40 && (t % 60) < 38) bios.text(66, 124, 'PRESS START', { color: P.WHITE });
    }
    if (paused) bios.text(90, 84, 'PAUSED', { color: P.WHITE, scale: 2 });
  }
}
function writeSave() {
  if (score > best) { best = score; try { save(new Uint8Array([best & 255, (best >> 8) & 255, (best >> 16) & 255])); } catch (e) { } }
}
function buildStarMap() {
  // BG0:星野两档 + 星云(176px 垂直循环图案 → 22 行)
  S.mapSize(0, 30, 44);
  var e = new Uint16Array(30 * 44);
  var seed = 77;
  for (var i = 0; i < 130; i++) {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    var x = seed % 30, y = (seed >> 6) % 44;
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    var ti = 1 + (seed % 3);
    if (rng) { }
    e[y * 30 + x] = S.entry(ti);
  }
  // 星云带
  for (var n = 0; n < 40; n++) {
    var nx = (n * 37) % 30, ny = ((n * 53) % 44);
    if ((nx + ny) % 3 === 0) e[ny * 30 + nx] = S.entry(T.NEB);
  }
  S.setMap(0, 0, 0, 30, 44, e);
}
function init() {
  S.loadTiles('bg', cart.seg('tilesbg', 0).data, 0);
  S.loadTiles('obj', cart.seg('tilesobj', 0).data, 0);
  S.backdrop(P.BG);
  buildStarMap();
  var d = load();
  best = d && d.length >= 3 ? d[0] | (d[1] << 8) | (d[2] << 16) : 0;
  scene = 'title'; paused = false;
  freeze = 0; flashT = 0;
  enemies = []; ebul = []; pbul = []; parts = []; pops = []; drops = [];
  boss = null; bossSeq = false;
  px = W / 2; py = H - 26; dead = false; inv = 0;
  score = 0; graze = 0;
}
var _stepRef = doUpdate;
update = function () { _stepRef(); draw(); };
