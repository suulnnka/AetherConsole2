/* —— 渲染 —— */
var zbuf = new Float32Array(W * H);
var camX = 0, camY = 0, camZ = 0;
var fwdX = 0, fwdY = 0, fwdZ = 1, rgtX = 1, rgtY = 0, rgtZ = 0, upX = 0, upY = 1, upZ = 0;
function setCam(x, y, z, yaw, pitch) {
  camX = x; camY = y; camZ = z;
  var cp = Math.cos(pitch), sp = Math.sin(pitch);
  var cy = Math.cos(yaw), sy = Math.sin(yaw);
  fwdX = sy * cp; fwdY = sp; fwdZ = cy * cp;
  rgtX = cy; rgtY = 0; rgtZ = -sy;
  upX = fwdY * rgtZ - fwdZ * rgtY;
  upY = fwdZ * rgtX - fwdX * rgtZ;
  upZ = fwdX * rgtY - fwdY * rgtX;
}
function toCam(x, y, z, out) {
  var rx = x - camX, ry = y - camY, rz = z - camZ;
  out[0] = rx * rgtX + ry * rgtY + rz * rgtZ;
  out[1] = rx * upX + ry * upY + rz * upZ;
  out[2] = rx * fwdX + ry * fwdY + rz * fwdZ;
}
function drawSky() {
  var yaw = Math.atan2(fwdX, fwdZ);
  var sd = angDiff(0.8, yaw);
  if (Math.abs(sd) < 1.15) {
    var sx = CX + Math.tan(sd) * F;
    var sy = 28 - fwdY * 44;
    for (var dy = -5; dy <= 5; dy++) for (var dx = -5; dx <= 5; dx++) {
      var r2 = dx * dx + dy * dy;
      if (r2 <= 30) R.pset((sx + dx) | 0, (sy + dy) | 0, r2 <= 14 ? P.ICE : P.HAZE);
