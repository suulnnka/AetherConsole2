}
var SPAWNS = [[180, 188], [72, 200], [30, 164], [180, 56], [156, 80], [216, 28], [76, 36], [30, 80], [120, 40], [120, 200], [40, 120], [200, 120], [190, 210], [24, 226]];

var GRES = 2, GN = 120;
var floorG = new Float32Array(GN * GN);
var flow = new Int16Array(GN * GN);
var flowQ = new Int32Array(GN * GN);
function buildNav() {
