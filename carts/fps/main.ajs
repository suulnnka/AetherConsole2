    var cx0 = Math.max(0, bo.x0 / GRES | 0), cx1 = Math.min(GN - 1, bo.x1 / GRES | 0);
    var cz0 = Math.max(0, bo.z0 / GRES | 0), cz1 = Math.min(GN - 1, bo.z1 / GRES | 0);
