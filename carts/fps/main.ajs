  var lim = fromY + STEP;
  for (var i = 0; i < boxes.length; i++) {
    var b = boxes[i];
    if (x > b.x0 && x < b.x1 && z > b.z0 && z < b.z1 && b.y1 <= lim && b.y1 > g) g = b.y1;
  }
  return g;
}
function moveXZ(e, dx, dz) {
  if (dx) {
    e.x += dx;
    for (var i = 0; i < boxes.length; i++) {
      var b = boxes[i];
      if (e.x + e.r > b.x0 && e.x - e.r < b.x1 && e.z + e.r > b.z0 && e.z - e.r < b.z1 &&
          b.y1 > e.y + 0.001 && b.y0 < e.y + e.h) {
        if (b.y1 <= e.y + STEP) e.y = b.y1;
        else e.x = dx > 0 ? b.x0 - e.r : b.x1 + e.r;
      }
    }
  }
  if (dz) {
    e.z += dz;
    for (var j = 0; j < boxes.length; j++) {
      var b2 = boxes[j];
      if (e.x + e.r > b2.x0 && e.x - e.r < b2.x1 && e.z + e.r > b2.z0 && e.z - e.r < b2.z1 &&
          b2.y1 > e.y + 0.001 && b2.y0 < e.y + e.h) {
        if (b2.y1 <= e.y + STEP) e.y = b2.y1;
        else e.z = dz > 0 ? b2.z0 - e.r : b2.z1 + e.r;
