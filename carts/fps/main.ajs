    player.hp = Math.min(player.maxHp, player.hp + 0.22);
  if (dmgT > 0) dmgT--;
  if (hitM > 0) hitM--;
  if (bannerT > 0) bannerT--;
  if (bobPh > 0) bobPh--;
  if (parts.length > 60) parts.splice(0, parts.length - 60);
}
function updateEnemies() {
  var ppx = player.x, ppy = player.y, ppz = player.z;
  for (var i = 0; i < enemies.length; i++) {
    var a = enemies[i];
    if (!a.alive) continue;
    for (var j = i + 1; j < enemies.length; j++) {
      var b = enemies[j];
      if (!b.alive) continue;
      var ddx = b.x - a.x, ddz = b.z - a.z;
      var d2 = ddx * ddx + ddz * ddz, rr = a.r + b.r + 0.25;
      if (d2 < rr * rr && d2 > 1e-6) {
        var d = Math.sqrt(d2), push = (rr - d) * 0.5 / d;
        a.x -= ddx * push; a.z -= ddz * push;
        b.x += ddx * push; b.z += ddz * push;
      }
    }
  }
  for (var k = enemies.length - 1; k >= 0; k--) {
    var e = enemies[k];
    e.animT++;
    if (e.flash > 0) e.flash--;
    if (!e.alive) { if (--e.dieT <= 0) enemies.splice(k, 1); continue; }
    var et = ETYPES[e.t];
    var dx = ppx - e.x, dz = ppz - e.z;
    var dist = Math.hypot(dx, dz);
    if (--e.losT <= 0) {
      e.losT = 8;
      e.los = dist < 48 && losClear(e.x, e.y + e.h * 0.8, e.z, ppx, ppy + EYE - 0.2, ppz);
    }
    var vx = 0, vz = 0;
    var ndx = dist > 0.01 ? dx / dist : 0, ndz = dist > 0.01 ? dz / dist : 0;
    if (e.t === 'stalker' || e.t === 'brute') {
      if (e.los && dist < 40) { vx = ndx * et.sp; vz = ndz * et.sp; }
      else { var f = flowDir(e.x, e.z); if (f) { vx = f[0] * et.sp; vz = f[1] * et.sp; } }
      if (dist < e.r + PR + 0.5 + (e.t === 'brute' ? 0.2 : 0) && Math.abs(e.y - ppy) < 2.5 && --e.atkCd <= 0) {
        e.atkCd = e.t === 'brute' ? 66 : 48;
        hurtPlayer(e.dmg);
      }
    } else if (e.t === 'sentry') {
      if (e.los && dist < 30) {
        var want = dist > 17 ? 1 : dist < 10 ? -0.8 : 0;
        var strafe2 = Math.sin(e.animT * 0.02 + e.seed);
        vx = (ndx * want - ndz * strafe2 * 0.7) * et.sp;
        vz = (ndz * want + ndx * strafe2 * 0.7) * et.sp;
        if (--e.atkCd <= 0) {
          e.atkCd = 86 + (rng() * 30 | 0);
          var ex = e.x, ey = e.y + e.h * 0.8, ez = e.z;
          var ddx2 = ppx + player.vx * 0.18 - ex, ddy2 = ppy + EYE - 0.3 - ey, ddz2 = ppz + player.vz * 0.18 - ez;
          var L = Math.hypot(ddx2, ddy2, ddz2) || 1;
          eballs.push({ x: ex, y: ey, z: ez, vx: ddx2 / L * 15, vy: ddy2 / L * 15, vz: ddz2 / L * 15, dmg: e.dmg, r: 0.16, ci: P.ORANGE });
        }
      } else { var f2 = flowDir(e.x, e.z); if (f2) { vx = f2[0] * et.sp; vz = f2[1] * et.sp; } }
    } else {
      var targetY = e.los ? ppy + 2.5 : groundY(e.x, e.z, e.y + 1) + 2.3;
      e.y += Math.max(-0.1, Math.min(0.1, targetY - e.y));
      if (e.los && dist < 34) {
        var orb = Math.sin(e.animT * 0.013 + e.seed) * 0.9;
        vx = (ndx + ndz * orb) * et.sp; vz = (ndz - ndx * orb) * et.sp;
        if (dist < 6) { vx -= ndx * et.sp * 0.9; vz -= ndz * et.sp * 0.9; }
        if (--e.atkCd <= 0) {
          e.atkCd = 64 + (rng() * 24 | 0);
          var ex2 = e.x, ey2 = e.y + e.h * 0.5, ez2 = e.z;
          var ddx3 = ppx - ex2, ddy3 = ppy + EYE - 0.4 - ey2, ddz3 = ppz - ez2;
          var L2 = Math.hypot(ddx3, ddy3, ddz3) || 1;
          eballs.push({ x: ex2, y: ey2, z: ez2, vx: ddx3 / L2 * 13, vy: ddy3 / L2 * 13, vz: ddz3 / L2 * 13, dmg: e.dmg, r: 0.12, ci: P.YEL });
        }
      } else {
        var f3 = flowDir(e.x, e.z);
        if (f3) { vx = f3[0] * et.sp; vz = f3[1] * et.sp; }
      }
    }
    moveXZ(e, vx / 60, vz / 60);
    if (e.t !== 'wasp') {
      var g = groundY(e.x, e.z, e.y);
      if (Math.abs(g - e.y) <= 1.2) e.y += (g - e.y) * 0.35;
    }
    var pd = Math.hypot(ppx - e.x, ppz - e.z);
    if (pd < e.r + PR && pd > 0.01) {
      var push2 = (e.r + PR - pd) / pd;
      e.x -= (ppx - e.x) * push2; e.z -= (ppz - e.z) * push2;
    }
  }
  for (var eb = eballs.length - 1; eb >= 0; eb--) {
    var b2 = eballs[eb];
    b2.x += b2.vx / 60; b2.y += b2.vy / 60; b2.z += b2.vz / 60;
    var dead = --b2.life <= 0;
    if (!dead && pointInBox(b2.x, b2.y, b2.z)) dead = true;
    if (!dead && scene === 'play' &&
        Math.abs(b2.x - player.x) < PR + b2.r && Math.abs(b2.z - player.z) < PR + b2.r &&
        b2.y > player.y && b2.y < player.y + PH) {
      hurtPlayer(b2.dmg);
      dead = true;
    }
    if (dead) eballs.splice(eb, 1);
  }
}
function updateFx() {
  for (var i = parts.length - 1; i >= 0; i--) {
    var p = parts[i];
    p.x += p.vx / 60; p.y += p.vy / 60; p.z += p.vz / 60;
    p.vy -= 8 / 60;
    if (p.y < 0.02) { p.y = 0.02; p.vy *= -0.3; p.vx *= 0.6; p.vz *= 0.6; }
    if (--p.life <= 0) parts.splice(i, 1);
  }
  for (var j = tracers.length - 1; j >= 0; j--) if (--tracers[j].life <= 0) tracers.splice(j, 1);
}
function doUpdate() {
  t++;
  if (scene === 'title' || scene === 'over') {
    if (pad.start.pressed || pad.a.pressed) resetRun();
    return;
  }
  if (pad.start.pressed) paused = !paused;
  if (paused) return;
  updatePlay();
}
function drawEnemy(e) {
  toCam(e.x, e.y + e.h * 0.5, e.z, _c);
  var Zc = _c[2];
  if (Zc < NEARZ + 0.2 || Zc > 128) return;
  var fg = Zc < 60 ? 0 : Zc < 95 ? 1 : 2;
  toCam(e.x, e.y, e.z, _s);
  var fx = CX + F * _s[0] / Zc, fy = CY - F * _s[1] / Zc;
  var k = F / Zc;
  var bw = e.w * k, bh = e.h * k;
  if (bh < 2.5) { zpx(fx, fy - 1, e.t === 'brute' ? P.RED : P.ORANGE, Zc); return; }
  var x0 = fx - bw / 2, y0 = fy - bh;
  var main = ETYPES[e.t].main, alt = ETYPES[e.t].alt;
  if (fg === 2) { main = alt = P.HAZE; }
  if (e.flash > 0) { main = alt = P.WHITE; }
  var dep = Zc - 0.05;
  if (!e.alive) {
    var q = e.dieT / 12;
    zrect(x0 - 1, fy - bh * 0.3 * q - 1, bw + 2, bh * 0.3 * q + 2, P.INKB, dep);
    zrect(x0, fy - bh * 0.28 * q, bw, bh * 0.28 * q, alt, dep);
    return;
  }
  zrect(x0 - 1, y0 - 1, bw + 2, bh + 2, P.INKB, dep);
  var legW = Math.max(1, bw * 0.26), legH = bh * 0.34;
  if (e.t === 'wasp') {
    zrect(x0, y0 + bh * 0.25, bw, bh * 0.5, main, dep);
    zrect(x0 + bw * 0.22, y0 + bh * 0.4, bw * 0.56, bh * 0.2, P.WHITE, dep);
    var th = e.animT % 12 < 6 ? 0 : 1;
    zrect(x0 + bw * 0.3, y0 + bh * 0.78, bw * 0.4, bh * 0.2 + th, alt, dep);
    zpx(x0 + bw * 0.2, y0 + bh * 0.2, P.WHITE, dep);
    zpx(x0 + bw * 0.8, y0 + bh * 0.2, P.WHITE, dep);
  } else {
    var ph = (e.animT >> 3) & 1;
    zrect(x0 + bw * 0.12, fy - legH, legW, legH - ph, alt, dep);
    zrect(x0 + bw * 0.62, fy - legH, legW, legH - (1 - ph), alt, dep);
    zrect(x0, y0 + bh * 0.3, bw, bh * 0.42, main, dep);
    zrect(x0 + bw * 0.1, y0 + bh * 0.3, bw * 0.8, bh * 0.1, alt, dep);
    zrect(x0 + bw * 0.24, y0, bw * 0.52, bh * 0.2, main, dep);
    if (e.animT % 44 < 30) {
      zpx(x0 + bw * 0.34, y0 + bh * 0.08, fg === 2 ? P.HAZE : P.YEL, dep);
      zpx(x0 + bw * 0.62, y0 + bh * 0.08, fg === 2 ? P.HAZE : P.YEL, dep);
    }
    if (e.t === 'sentry') zrect(x0 + bw * 0.7, y0 + bh * 0.44, bw * 0.5, Math.max(1, bh * 0.08), P.INKB, dep);
    if (e.t === 'brute') {
      zrect(x0 - 1, y0 + bh * 0.3, bw * 0.24, bh * 0.24, alt, dep);
      zrect(x0 + bw * 0.77, y0 + bh * 0.3, bw * 0.24, bh * 0.24, alt, dep);
    }
  }
}
function renderWorld() {
  R.clear(P.SKY);
  drawSky();
  zbuf.fill(1e9);
  drawFloorRows();
  drawBoxes();
  for (var i = 0; i < tracers.length; i++)
    zseg(tracers[i].x0, tracers[i].y0, tracers[i].z0, tracers[i].x1, tracers[i].y1, tracers[i].z1, tracers[i].life === 3 ? P.WHITE : P.GOLD);
  for (var e = 0; e < enemies.length; e++) drawEnemy(enemies[e]);
  for (var b = 0; b < eballs.length; b++) {
    toCam(eballs[b].x, eballs[b].y, eballs[b].z, _c);
    if (_c[2] < NEARZ + 0.2 || _c[2] > 128) continue;
    var k = F / _c[2];
    var sx = CX + F * _c[0] / _c[2], sy = CY - F * _c[1] / _c[2];
    var s = Math.max(1.5, eballs[b].r * 2 * k);
    zrect(sx - s / 2, sy - s / 2, s, s, eballs[b].ci, _c[2] - 0.05);
    zpx(sx, sy, P.WHITE, _c[2] - 0.06);
  }
  for (var p = 0; p < parts.length; p++) {
    toCam(parts[p].x, parts[p].y, parts[p].z, _c);
    if (_c[2] < NEARZ + 0.1 || _c[2] > 90) continue;
    zpx(CX + F * _c[0] / _c[2], CY - F * _c[1] / _c[2], parts[p].ci, _c[2] - 0.03);
  }
}
function drawGun() {
  var bob = Math.sin(bobT) * 1.4;
  var bobX = Math.cos(bobT * 0.5) * 1.1;
  var gx = Math.round(W * 0.6 + bobX - player.turnVel * 0.8);
  var gy = Math.round(H - 3 + recoil * 1.7 + bob + bobPh);
  R.rect(gx, gy - 15, 26, 8, P.DGRAY);
  R.rect(gx + 26, gy - 13, 17, 4, P.INKB);
  R.rect(gx + 43, gy - 14, 4, 6, P.INKB);
  R.rect(gx + 6, gy - 7, 7, 9, P.GRAY);
  R.rect(gx + 17, gy - 7, 8, 6, P.STEEL);
  R.rect(gx + 2, gy - 18, 10, 3, P.INKB);
  R.rect(gx + 36, gy - 16, 2, 3, P.INKB);
  R.rect(gx + 23, gy - 13, 2, 2, P.CYAN);
  if (muzzleT > 0) {
    var mx = gx + 47, my = gy - 11, r = muzzleT;
    R.rect(mx - 2, my - 5 - r, 4, 3 + r, P.WHITE);
    R.rect(mx - 5 - r, my - 2, 3 + r, 4, P.GOLD);
    R.rect(mx + 2, my - 2, 3 + r, 4, P.GOLD);
    R.rect(mx - 1, my - 1, 3, 3, P.WHITE);
  }
}
function drawHud() {
  bios.text(4, 2, 'WAVE ' + wave, { color: P.BLACK });
  var alive = 0;
  for (var i = 0; i < enemies.length; i++) if (enemies[i].alive) alive++;
  bios.text(4, 16, clearPending ? 'CLEAR' : 'FOES ' + alive, { color: P.DRED });
  bios.text(4, 30, '' + score, { color: P.INKB });
  bios.text(4, H - 24, 'HP', { color: P.BLACK });
  R.rect(28, H - 22, 48, 8, P.BLACK);
  R.rect(29, H - 21, 46, 6, P.WHITE);
  R.rect(29, H - 21, Math.round(46 * Math.max(0, player.hp) / player.maxHp), 6, player.hp > 30 ? P.RED : P.DRED);
  bios.text(180, H - 24, 'INFINITE', { color: P.INKB });
  // 准星
  var g = 3 + Math.round(spread * 800);
  R.line(CX, CY - g - 3, CX, CY - g, P.BLACK, 1);
  R.line(CX, CY + g, CX, CY + g + 3, P.BLACK, 1);
  R.line(CX - g - 3, CY, CX - g, CY, P.BLACK, 1);
  R.line(CX + g, CY, CX + g + 3, CY, P.BLACK, 1);
  R.pset(CX, CY, P.BLACK);
  if (hitM > 0) {
    var ci = hitKill ? P.RED : P.WHITE;
    var s2 = hitKill ? 5 : 4;
    R.line(CX - 2, CY - 2, CX - s2, CY - s2, ci, 1);
    R.line(CX + 2, CY - 2, CX + s2, CY - s2, ci, 1);
    R.line(CX - 2, CY + 2, CX - s2, CY + s2, ci, 1);
    R.line(CX + 2, CY + 2, CX + s2, CY + s2, ci, 1);
  }
  if (dmgT > 0) {
    var th = Math.min(5, dmgT >> 2) + 1;
    R.rect(0, 0, W, th, P.RED); R.rect(0, H - th, W, th, P.RED);
    R.rect(0, 0, th, H, P.RED); R.rect(W - th, 0, th, H, P.RED);
  }
  if (bannerT > 0 && (bannerT > 16 || (t % 4) < 2)) {
    bios.text((240 - ('WAVE ' + wave).length * 24) / 2 | 0, 33, 'WAVE ' + wave, { color: P.BLACK, scale: 2 });
    bios.text((240 - bannerSub.length * 12) / 2 | 0, 52, bannerSub, { color: P.DRED });
  }
  if (clearPending && interT > 0)
    bios.text(66, 2, 'NEXT ' + Math.ceil(interT / 60), { color: P.BLACK });
  if (player.hp <= 0 && scene === 'play')
    bios.text(66, 66, 'SIGNAL LOST', { color: P.RED, scale: 2 });
}
function draw() {
  if (scene === 'title') {
    var a = t * 0.004, R2 = 64;
    var cx = 120 + Math.cos(a) * R2, cz = 120 + Math.sin(a) * R2;
    setCam(cx, 15, cz, Math.atan2(120 - cx, 120 - cz), -0.13);
    renderWorld();
    bios.text(60, 12, 'PALE CITADEL', { color: P.RED, scale: 2 });
    bios.text(66, 36, '3D WAVE SHOOTER', { color: P.INKB });
    if (best) bios.text(48, 50, 'BEST W' + best.w + ' ' + best.s, { color: P.GOLD });
    if ((t % 60) < 38) bios.text(66, 74, 'PRESS START', { color: P.BLACK, scale: 2 });
    bios.text(30, 100, 'WASD MOVE MOUSE AIM LMB FIRE', { color: P.DGRAY });
    bios.text(54, 112, 'B JUMP ENTER PAUSE', { color: P.DGRAY });
    bios.text(36, 124, 'MOUSE HORIZON TURNS VIEW', { color: P.DGRAY });
    bios.text(48, 136, 'INFINITE AMMO HOLD LINE', { color: P.DRED });
    return;
  }
  setCam(player.x, player.y + EYE, player.z, player.yaw, player.pitch);
  renderWorld();
  drawGun();
  drawHud();
  if (scene === 'over') {
    bios.text(72, 42, 'GAME OVER', { color: P.RED, scale: 2 });
    bios.text(66, 70, 'REACHED WAVE ' + wave, { color: P.INKB });
    bios.text(72, 84, 'KILLS ' + kills, { color: P.INKB });
    bios.text(66, 98, 'SCORE ' + score, { color: P.INKB });
    if (best) bios.text(72, 112, 'BEST W' + best.w, { color: P.GOLD });
    if ((t % 60) < 38) bios.text(54, 128, 'PRESS START REDEPLOY', { color: P.BLACK });
  }
  if (paused) {
    bios.text(90, 76, 'PAUSED', { color: P.BLACK, scale: 2 });
    bios.text(78, 94, 'ENTER TO RESUME', { color: P.INKB });
  }
}
function init() {
  boxes.length = 0;
  buildMap();
  buildNav();
  enemies = []; eballs = []; parts = []; tracers = [];
  scene = 'title'; paused = false;
  player = { x: 120, y: 1.6, z: 136, vx: 0, vy: 0, vz: 0, r: PR, h: PH, yaw: 3.1416, pitch: 0, hp: 100, maxHp: 100, grounded: true, turnVel: 0 };
  wave = 1; score = 0; kills = 0;
  bannerT = 0; dmgT = 0; hitM = 0; overT = 0;
  best = null;
}
var _stepRef = doUpdate;
update = function () { _stepRef(); draw(); };
