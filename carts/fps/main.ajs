  var pp, qq;
  if (p[2] < NEARZ) {
    var k = (NEARZ - p[2]) / (q[2] - p[2]);
    pp = [p[0] + (q[0] - p[0]) * k, p[1] + (q[1] - p[1]) * k, NEARZ]; qq = q;
  } else if (q[2] < NEARZ) {
    var k2 = (NEARZ - q[2]) / (p[2] - q[2]);
    qq = [q[0] + (p[0] - q[0]) * k2, q[1] + (p[1] - q[1]) * k2, NEARZ]; pp = p;
  } else { pp = p; qq = q; }
  zlineScr(CX + F * pp[0] / pp[2], CY - F * pp[1] / pp[2], 1 / pp[2],
           CX + F * qq[0] / qq[2], CY - F * qq[1] / qq[2], 1 / qq[2], ci);
}
var ETYPES = {
  stalker: { hp: 34, sp: 4.6, dmg: 10, r: 0.38, h: 1.7, w: 0.62, score: 100, main: P.AMBER, alt: P.YEL },
  wasp: { hp: 26, sp: 4.2, dmg: 6, r: 0.34, h: 1.0, w: 0.9, score: 150, main: P.YEL, alt: P.GOLD },
  sentry: { hp: 58, sp: 3.4, dmg: 9, r: 0.40, h: 1.8, w: 0.80, score: 200, main: P.ORANGE, alt: P.RORANGE },
  brute: { hp: 260, sp: 2.1, dmg: 24, r: 0.62, h: 2.5, w: 1.5, score: 500, main: P.RED, alt: P.DRED }
};
var scene, paused;
var player, enemies, eballs, parts, tracers;
var wave, quota, spawned, spawnT, interT, clearPending;
var score, kills, best;
var recoil = 0, muzzleT = 0, spread = 0, pitchKick = 0;
var fireCd = 0, bobT = 0, bobPh = 0, coyote = 0, jumpBuf = 0;
var dmgT = 0, hitM = 0, hitKill = false, bannerT = 0, bannerSub = '';
var lastHitT = 0, overT = 0, flowT = 0, t = 0;
function makeEnemy(type, x, z, hpMul, dmgMul) {
  var et = ETYPES[type];
  return { t: type, x: x, z: z, y: 0, vy: 0, r: et.r, h: et.h, w: et.w,
           hp: et.hp * hpMul, maxHp: et.hp * hpMul, dmg: et.dmg * dmgMul,
           animT: (rng() * 60) | 0, seed: rng() * 6.28,
           atkCd: 30 + (rng() * 40 | 0), los: false, losT: (rng() * 8) | 0,
           flash: 0, dieT: 0, alive: true };
}
function resetRun() {
  player = { x: 120, y: 1.6, z: 136, vx: 0, vy: 0, vz: 0, r: PR, h: PH, yaw: 3.1416, pitch: 0, hp: 100, maxHp: 100, grounded: true, turnVel: 0 };
  enemies = []; eballs = []; parts = []; tracers = [];
  wave = 0; score = 0; kills = 0;
  clearPending = false; interT = 0;
  recoil = 0; muzzleT = 0; spread = 0; fireCd = 0; pitchKick = 0;
  dmgT = 0; hitM = 0; bannerT = 0; lastHitT = 999; overT = 0;
  coyote = 0; jumpBuf = 0;
  paused = false;
  nextWave();
  scene = 'play';
}
function nextWave() {
  wave++;
  quota = Math.min(48, 4 + wave * 4);
  spawned = 0; spawnT = 40;
  bannerT = 140; bannerSub = 'HOSTILES ' + quota;
  rebuildFlow(player.x, player.z); flowT = 0;
}
function pickType(w) {
  var r = rng();
  if (w <= 1) return 'stalker';
  if (w === 2) return r < 0.6 ? 'stalker' : 'wasp';
  if (w <= 4) return r < 0.4 ? 'stalker' : r < 0.65 ? 'wasp' : 'sentry';
  if (w <= 7) return r < 0.3 ? 'stalker' : r < 0.55 ? 'wasp' : r < 0.85 ? 'sentry' : 'brute';
  return r < 0.24 ? 'stalker' : r < 0.48 ? 'wasp' : r < 0.78 ? 'sentry' : 'brute';
}
function spawnEnemy() {
  var pt = null;
  for (var tries = 0; tries < 8; tries++) {
    var s = SPAWNS[(rng() * SPAWNS.length) | 0];
    var d = Math.hypot(s[0] - player.x, s[1] - player.z);
    if (d > 35 && d < 115) { pt = s; break; }
    if (!pt) pt = s;
  }
  var hpMul = Math.min(3.2, 1 + 0.08 * (wave - 1));
  var dmgMul = Math.min(2.4, 1 + 0.05 * (wave - 1));
  var e = makeEnemy(pickType(wave), pt[0] + rng() * 4 - 2, pt[1] + rng() * 4 - 2, hpMul, dmgMul);
  e.y = groundY(e.x, e.z, 4);
  enemies.push(e);
}
function hurtPlayer(dmg) {
  if (scene !== 'play' || player.hp <= 0) return;
  player.hp -= dmg;
  dmgT = 22; lastHitT = 0;
  A.playSfx(3);
  if (player.hp <= 0) {
    player.hp = 0;
    if (!best || wave > best.w || (wave === best.w && score > best.s)) best = { w: wave, s: score };
    overT = 70;
    for (var i = 0; i < 20; i++)
      parts.push({ x: player.x, y: player.y + 1, z: player.z, vx: rng() * 6 - 3, vy: rng() * 4, vz: rng() * 6 - 3, life: 20 + rng() * 24 | 0, ci: [P.RED, P.ORANGE, P.WHITE][i % 3] });
  }
}
function fireGun() {
  fireCd = 7;
  recoil = Math.min(7, recoil + 2.6);
  muzzleT = 4;
  spread = Math.min(0.05, spread + 0.007);
  pitchKick = 0.012;
  A.playSfx(6);
  var yaw = player.yaw + (rng() * 2 * spread - spread);
  var pitch = Math.max(-PITCH_MAX, Math.min(PITCH_MAX, player.pitch + (rng() * 2 * spread - spread) * 0.7));
  var cp = Math.cos(pitch);
  var dx = Math.sin(yaw) * cp, dy = Math.sin(pitch), dz = Math.cos(yaw) * cp;
  var ox = player.x, oy = player.y + EYE, oz = player.z;
  var wallT = rayWorld(ox, oy, oz, dx, dy, dz, 200);
  var hitE = null, hitT = wallT, head = false;
  for (var i = 0; i < enemies.length; i++) {
    var e = enemies[i];
    if (!e.alive) continue;
    var bb = { x0: e.x - e.r, x1: e.x + e.r, y0: e.y, y1: e.y + e.h, z0: e.z - e.r, z1: e.z + e.r };
    var tt = rayBox(ox, oy, oz, dx, dy, dz, bb, hitT);
    if (tt > 0 && tt < hitT) {
      hitT = tt; hitE = e;
      head = (oy + dy * tt) > e.y + e.h * 0.76;
    }
  }
  var hx = ox + dx * hitT, hy = oy + dy * hitT, hz = oz + dz * hitT;
  tracers.push({ x0: ox + Math.sin(player.yaw) * 0.4, y0: oy - 0.16, z0: oz + Math.cos(player.yaw) * 0.4, x1: hx, y1: hy, z1: hz, life: 3 });
  if (hitE) {
    hitE.hp -= head ? 16 : 9;
    hitE.flash = 3;
    hitM = 7; hitKill = false;
    for (var p = 0; p < 3; p++)
      parts.push({ x: hx, y: hy, z: hz, vx: rng() * 4 - 2, vy: rng() * 3, vz: rng() * 4 - 2, life: 6 + rng() * 8 | 0, ci: p & 1 ? ETYPES[hitE.t].main : P.YEL });
    if (hitE.hp <= 0 && hitE.alive) {
      hitE.alive = false; hitE.dieT = 12;
      hitM = 12; hitKill = true;
      kills++;
      score += Math.round(ETYPES[hitE.t].score * (1 + 0.06 * (wave - 1)));
      var big = hitE.t === 'brute';
      for (var q = 0; q < (big ? 20 : 10); q++)
        parts.push({ x: hitE.x, y: hitE.y + hitE.h / 2, z: hitE.z, vx: rng() * 8 - 4, vy: 1 + rng() * 5, vz: rng() * 8 - 4, life: 14 + rng() * 16 | 0, ci: [ETYPES[hitE.t].main, ETYPES[hitE.t].alt, P.YEL, P.WHITE][q % 4] });
      A.playSfx(4);
    }
  } else {
    for (var w = 0; w < 3; w++)
      parts.push({ x: hx - dx * 0.1, y: hy - dy * 0.1, z: hz - dz * 0.1, vx: rng() * 3 - 1.5, vy: rng() * 2, vz: rng() * 3 - 1.5, life: 5 + rng() * 5 | 0, ci: w & 1 ? P.WHITE : P.GRAY });
  }
}
function updatePlay() {
  // 视角:鼠标绝对偏移转向
  var turned = 0;
  var mOffX = mouse.x - CX, mOffY = mouse.y - CY;
  if (Math.abs(mOffX) > 6) { player.yaw += Math.max(-6, Math.min(6, mOffX * 0.06)) * 0.045; turned = mOffX; }
  if (Math.abs(mOffY) > 6) player.pitch = Math.max(-PITCH_MAX, Math.min(PITCH_MAX, player.pitch - Math.max(-6, Math.min(6, mOffY * 0.06)) * 0.03));
  if (pad.left.down || pad.right.down || pad.up.down || pad.down.down) {
    // 键盘转向:左右键水平转
    if (pad.left.down) { player.yaw -= 0.052; turned = -8; }
    if (pad.right.down) { player.yaw += 0.052; turned = 8; }
  }
  if (pitchKick) {
    player.pitch = Math.max(-PITCH_MAX, Math.min(PITCH_MAX, player.pitch + pitchKick));
    pitchKick *= 0.5;
    if (pitchKick < 0.001) pitchKick = 0;
  }
  player.turnVel += (turned - player.turnVel) * 0.3;
  // 移动(AC1 左右反移在此修正:右键向右平移)
  var fx0 = Math.sin(player.yaw), fz0 = Math.cos(player.yaw);
  var mx = 0, mz = 0;
  var upK = pad.up.down || mouse.left && false;
  if (pad.up.down) { mx += fx0; mz += fz0; }
  if (pad.down.down) { mx -= fx0; mz -= fz0; }
  var strafe = 0;
  if (pad.a.down) strafe += 1;       // A/Z = 右平移(修正后)
  if (pad.b.down) strafe -= 1;       // B/X = 左平移?——B 同时是跳。
  // 跳跃绑定 B(按下沿);平移用 A/B 不行(B=跳)→ 平移改为:W 上 S 下 + 左右键转向 + 鼠标水平偏移平移?
  // 最终方案:方向键/WASD 前后,左右平移 = A(右)/B 不用 —— 为保双手布局:A=右平移,B=跳跃。
  mx += fz0 * strafe; mz -= fx0 * strafe;
  var ml = Math.hypot(mx, mz);
  if (ml > 0) { mx = mx / ml * 5.6; mz = mz / ml * 5.6; }
  var acc = player.grounded ? 0.22 : 0.05;
  player.vx += (mx - player.vx) * acc;
  player.vz += (mz - player.vz) * acc;
  if (ml > 0 && player.grounded) bobT += 0.22;
  if (pad.b.pressed) jumpBuf = 7;
  if (jumpBuf > 0) jumpBuf--;
  if (player.grounded) coyote = 7; else if (coyote > 0) coyote--;
  if (jumpBuf > 0 && coyote > 0) { player.vy = JUMP_V; player.grounded = false; coyote = 0; jumpBuf = 0; A.playSfx(1); }
  player.vy -= GRAV / 60;
  if (player.vy < -22) player.vy = -22;
  var wasGrounded = player.grounded, fallV = player.vy;
  moveXZ(player, player.vx / 60, 0);
  moveXZ(player, 0, player.vz / 60);
  player.y += player.vy / 60;
  if (player.vy > 0)
    for (var bi = 0; bi < boxes.length; bi++) {
      var b = boxes[bi];
      if (player.x + PR > b.x0 && player.x - PR < b.x1 && player.z + PR > b.z0 &&
          player.z - PR < b.z1 && b.y0 > player.y + 0.1 && b.y0 < player.y + PH) {
        player.y = b.y0 - PH; player.vy = 0;
      }
    }
  var sup = groundY(player.x, player.z, player.y);
  player.grounded = false;
  if (player.vy <= 0 && player.y <= sup + 0.001) {
    player.y = sup; player.vy = 0; player.grounded = true;
    if (!wasGrounded && fallV < -7) bobPh = 4;
  } else if (wasGrounded && player.y - sup <= STEP && player.vy <= 0) {
    player.y = sup; player.grounded = true;
  }
  player.x = Math.max(4, Math.min(236, player.x));
  player.z = Math.max(4, Math.min(236, player.z));
  if (fireCd > 0) fireCd--;
  if (mouse.left && fireCd <= 0) fireGun();
  recoil *= 0.82;
  if (muzzleT > 0) muzzleT--;
  spread = Math.max(0.011, spread * 0.94);
  if (ml > 0 && player.grounded) spread = Math.min(0.05, spread + 0.0004);
  if (player.hp <= 0) {
    overT--;
    updateFx();
    if (overT <= 0) scene = 'over';
    return;
  }
  if (clearPending) {
    interT--;
    if (interT <= 0) { clearPending = false; nextWave(); }
  } else {
    var alive = 0;
    for (var a = 0; a < enemies.length; a++) if (enemies[a].alive) alive++;
    if (spawned < quota && alive < Math.min(12, 5 + wave)) {
      if (--spawnT <= 0) { spawnT = Math.max(16, 46 - wave * 2); spawnEnemy(); spawned++; }
    } else if (spawned >= quota && alive === 0) {
      clearPending = true; interT = 190;
      player.hp = Math.min(player.maxHp, player.hp + 30);
      score += wave * 100;
      bannerT = 130; bannerSub = 'AREA SECURED +' + wave * 100;
      if (!best || wave > best.w) best = { w: wave, s: score };
      A.playSfx(5);
    }
  }
  if (++flowT >= 22) { flowT = 0; rebuildFlow(player.x, player.z); }
  updateEnemies();
  updateFx();
  lastHitT++;
