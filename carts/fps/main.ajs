}
function cellFloor(gx, gz) { return (gx < 0 || gz < 0 || gx >= GN || gz >= GN) ? 99 : floorG[gz * GN + gx]; }
function rebuildFlow(ppx, ppz) {
  flow.fill(-1);
  var sx = Math.max(0, Math.min(GN - 1, ppx / GRES | 0));
  var sz = Math.max(0, Math.min(GN - 1, ppz / GRES | 0));
  var head = 0, tail = 0;
  flow[sz * GN + sx] = 0; flowQ[tail++] = sz * GN + sx;
  while (head < tail) {
    var i = flowQ[head++], gx = i % GN, gz = i / GN | 0, d = flow[i], f0 = floorG[i];
    if (d > 250) continue;
    for (var k = 0; k < 4; k++) {
      var nx = gx + (k === 0 ? 1 : k === 1 ? -1 : 0);
      var nz = gz + (k === 2 ? 1 : k === 3 ? -1 : 0);
      if (nx < 0 || nz < 0 || nx >= GN || nz >= GN) continue;
      var j = nz * GN + nx;
      if (flow[j] >= 0) continue;
      if (Math.abs(floorG[j] - f0) > 0.56) continue;
      flow[j] = d + 1; flowQ[tail++] = j;
    }
  }
}
function flowDir(x, z) {
  var gx = Math.max(0, Math.min(GN - 1, x / GRES | 0));
  var gz = Math.max(0, Math.min(GN - 1, z / GRES | 0));
  var d0 = flow[gz * GN + gx];
  if (d0 < 0) return null;
  var bx = 0, bz = 0, best = d0;
  for (var k = 0; k < 4; k++) {
    var nx = gx + (k === 0 ? 1 : k === 1 ? -1 : 0);
    var nz = gz + (k === 2 ? 1 : k === 3 ? -1 : 0);
    if (nx < 0 || nz < 0 || nx >= GN || nz >= GN) continue;
