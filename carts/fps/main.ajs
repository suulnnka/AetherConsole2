      if (ta > t0) t0 = ta;
      if (tb < t1) t1 = tb;
      if (t0 > t1) return -1;
    }
  }
  return t0 > 0.001 ? t0 : -1;
}
function rayWorld(ox, oy, oz, dx, dy, dz, tMax) {
